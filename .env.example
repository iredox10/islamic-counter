# Appwrite Configuration (required for push notifications & analytics)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_PUSH_FUNCTION_ID=your-function-id

# Appwrite Admin API Key (for creating collections - DO NOT use in client code)
# Create at: Console > API Keys > Create Key with scopes: collections.create, attributes.create
APPWRITE_API_KEY=your-admin-api-key